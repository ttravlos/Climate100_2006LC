+import kotlinx.coroutines.delay
+import java.time.LocalTime
+import java.time.format.DateTimeFormatter
+
+class MainActivity : ComponentActivity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        setContent {
+            MaterialTheme(
+                colorScheme = darkColorScheme()
+            ) {
+                LauncherScreen()
+            }
+        }
+    }
+}
+
+private val ScreenBackground = Color(0xFF080B0F)
+private val CardBackground = Color(0xFF151A20)
+private val ButtonBackground = Color(0xFF202832)
+private val BorderColor = Color(0xFF37414D)
+private val PrimaryText = Color(0xFFF2F5F7)
+private val SecondaryText = Color(0xFF9DA8B3)
+private val Accent = Color(0xFF55B7FF)
+
+@Composable
+private fun LauncherScreen() {
+    Surface(
+        modifier = Modifier.fillMaxSize(),
+        color = ScreenBackground
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(18.dp),
+            verticalArrangement = Arrangement.spacedBy(14.dp)
+        ) {
+            StatusBar()
+
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f),
+                horizontalArrangement = Arrangement.spacedBy(14.dp)
+            ) {
+                MapCard(
+                    modifier = Modifier
+                        .weight(1.65f)
+                        .fillMaxHeight()
+                )
+
+                Column(
+                    modifier = Modifier
+                        .weight(1f)
+                        .fillMaxHeight(),
+                    verticalArrangement = Arrangement.spacedBy(14.dp)
+                ) {
+                    ClimateCard(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .weight(1f)
+                    )
+
+                    MediaCard(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .weight(1f)
+                    )
+                }
+            }
+
+            AppButtonGrid()
+        }
+    }
+}
+
+@Composable
+private fun StatusBar() {
+    var currentTime by remember { mutableStateOf(formattedTime()) }
+
+    LaunchedEffect(Unit) {
+        while (true) {
+            currentTime = formattedTime()
+            delay(30_000)
+        }
+    }
+
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(58.dp)
+            .padding(horizontal = 8.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        Text(
+            text = currentTime,
+            color = PrimaryText,
+            fontSize = 27.sp,
+            fontWeight = FontWeight.SemiBold
+        )
+
+        Spacer(modifier = Modifier.weight(1f))
+
+        Text(
+            text = "68°F",
+            color = PrimaryText,
+            fontSize = 24.sp,
+            fontWeight = FontWeight.Medium
+        )
+
+        Text(
+            text = "   Wi-Fi   GPS",
+            color = SecondaryText,
+            fontSize = 19.sp
+        )
+    }
+}
+
+@Composable
+private fun MapCard(modifier: Modifier = Modifier) {
+    DashboardCard(modifier = modifier) {
+        Box(
+            modifier = Modifier.fillMaxSize(),
+            contentAlignment = Alignment.Center
+        ) {
+            Column(
+                horizontalAlignment = Alignment.CenterHorizontally
+            ) {
+                Text(
+                    text = "NAVIGATION",
+                    color = SecondaryText,
+                    fontSize = 18.sp,
+                    fontWeight = FontWeight.Bold
+                )
+
+                Spacer(modifier = Modifier.height(14.dp))
+
+                Text(
+                    text = "Map area",
+                    color = PrimaryText,
+                    fontSize = 38.sp,
+                    fontWeight = FontWeight.Medium
+                )
+
+                Spacer(modifier = Modifier.height(10.dp))
+
+                Text(
+                    text = "Google Maps or preferred navigation",
+                    color = SecondaryText,
+                    fontSize = 18.sp
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun ClimateCard(modifier: Modifier = Modifier) {
+    DashboardCard(modifier = modifier) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(22.dp),
+            verticalArrangement = Arrangement.SpaceBetween
+        ) {
+            Text(
+                text = "CLIMATE",
+                color = SecondaryText,
+                fontSize = 17.sp,
+                fontWeight = FontWeight.Bold
+            )
+
+            Row(
+                verticalAlignment = Alignment.Bottom
+            ) {
+                Text(
+                    text = "72°",
+                    color = PrimaryText,
+                    fontSize = 58.sp,
+                    fontWeight = FontWeight.Light
+                )
+
+                Column(
+                    modifier = Modifier.padding(start = 20.dp, bottom = 7.dp)
+                ) {
+                    Text(
+                        text = "AUTO",
+                        color = Accent,
+                        fontSize = 21.sp,
+                        fontWeight = FontWeight.Bold
+                    )
+
+                    Text(
+                        text = "Fan 3",
+                        color = SecondaryText,
+                        fontSize = 19.sp
+                    )
+                }
+            }
+
+            Text(
+                text = "A/C on  •  Face + feet",
+                color = SecondaryText,
+                fontSize = 17.sp
+            )
+        }
+    }
+}
+
+@Composable
+private fun MediaCard(modifier: Modifier = Modifier) {
+    DashboardCard(modifier = modifier) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(22.dp),
+            verticalArrangement = Arrangement.Center
+        ) {
+            Text(
+                text = "NOW PLAYING",
+                color = SecondaryText,
+                fontSize = 17.sp,
+                fontWeight = FontWeight.Bold
+            )
+
+            Spacer(modifier = Modifier.height(20.dp))
+
+            Text(
+                text = "No media playing",
+                color = PrimaryText,
+                fontSize = 27.sp,
+                fontWeight = FontWeight.Medium
+            )
+
+            Spacer(modifier = Modifier.height(8.dp))
+
+            Text(
+                text = "Open a music app to begin",
+                color = SecondaryText,
+                fontSize = 18.sp
+            )
+        }
+    }
+}
+
+@Composable
+private fun AppButtonGrid() {
+    val context = LocalContext.current
+    Column(
+        modifier = Modifier.fillMaxWidth(),
+        verticalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            LauncherButton("Navigation", Modifier.weight(1f)) {
+                AppLauncher.openNavigation(context)
+            }
+            LauncherButton("Music", Modifier.weight(1f)) {
+                AppLauncher.openMusic(context)
+            }
+            LauncherButton("Climate", Modifier.weight(1f)) {
+                AppLauncher.openClimate(context)
+            }
+        }
+
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            LauncherButton("Phone", Modifier.weight(1f)) {
+                AppLauncher.openPhone(context)
+            }
+            LauncherButton("Home Assistant", Modifier.weight(1f)) {
+                AppLauncher.openHomeAssistant(context)
+            }
+            LauncherButton("Apps", Modifier.weight(1f)) {
+                AppLauncher.openApps(context)
+            }
+        }
+    }
+
+}
+@Composable
+private fun LauncherButton(
+    label: String,
+    modifier: Modifier = Modifier,
+    onClick: () -> Unit
+) {
+    Button(
+        onClick = onClick,
+        modifier = modifier.height(74.dp),
+        shape = RoundedCornerShape(12.dp),
+        colors = ButtonDefaults.buttonColors(
+            containerColor = ButtonBackground,
+            contentColor = PrimaryText
+        )
+    ) {
+        Text(
+            text = label,
+            fontSize = 20.sp,
+            fontWeight = FontWeight.SemiBold
+        )
+    }
+}
+
+@Composable
+private fun DashboardCard(
+    modifier: Modifier = Modifier,
+    content: @Composable () -> Unit
+) {
+    Box(
+        modifier = modifier
+            .background(
+                color = CardBackground,
+                shape = RoundedCornerShape(14.dp)
+            )
+            .border(
+                width = 1.dp,
+                color = BorderColor,
+                shape = RoundedCornerShape(14.dp)
+            )
+    ) {
+        content()
+    }
+}
+
+private fun formattedTime(): String {
+    return LocalTime.now().format(
+        DateTimeFormatter.ofPattern("h:mm a")
+    )
